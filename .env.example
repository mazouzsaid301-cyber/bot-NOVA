# ============================================================
# EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT (BOT DISCORD & API)
# Copiez ce fichier en tant que .env et renseignez vos valeurs réelles.
# Ne committez JAMAIS le fichier .env dans Git.
# ============================================================

# --- Identifiants Discord Developer Portal ---
# Discord Developer Portal > Applications > [Votre App] > Bot > Reset Token
DISCORD_TOKEN=votre_token_secret_discord_ici

# Discord Developer Portal > Applications > [Votre App] > General Information > Application ID
CLIENT_ID=votre_application_client_id_ici

# ID du serveur Discord principal (Mode Développeur Discord > Clic droit sur le serveur > Copier l'identifiant)
GUILD_ID=votre_guild_id_ici

# --- Configuration du Serveur HTTP & API du Bot ---
# Port d'écoute du serveur Node.js hébergeant l'API
PORT=3000
DASHBOARD_PORT=3000

# Environnement d'exécution (development ou production)
NODE_ENV=production

# --- Sécurité & Authentification du Dashboard ---
# Mot de passe sécurisé pour l'accès administrateur au tableau de bord
DASHBOARD_PASSWORD=choisissez_un_mot_de_passe_tres_robuste

# Secret cryptographique aléatoire de 64+ caractères pour signer les sessions et tokens HMAC
# Astuce: générez-en un avec: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=votre_session_secret_aleatoire_tres_long

# --- Domaines & CORS ---
# URL publique du dashboard hébergé sur Netlify
DASHBOARD_PUBLIC_URL=https://mazoodev.com
DASHBOARD_URL=https://mazoodev.com

# URL publique de l'API persistante du bot (Render, Railway, Fly.io ou VPS)
API_BASE_URL=https://votre-bot-persistent.onrender.com

# Origines autorisées pour les requêtes CORS (séparées par des virgules)
CORS_ORIGIN=https://mazoodev.com,https://www.mazoodev.com,http://localhost:5173,http://localhost:3000

# --- Base de Données Persistante ---
# Chemin vers le fichier SQLite persistant
# Sur Render/Railway avec volume monté sur /data, utilisez: /data/bot.sqlite
DATABASE_PATH=data/bot.sqlite

# --- Salons Discord Optionnels ---
# ID du salon textuel pour les logs et audits (peut aussi être configuré via /setup-logs)
LOG_CHANNEL_ID=

# ID de la catégorie sous laquelle ouvrir les salons de tickets
TICKET_CATEGORY_ID=
