{
  "name": "discord-all-in-one-bot",
  "version": "1.0.0",
  "description": "Bot Discord tout-en-un: tickets, redeem, moderation, économie, logs et dashboard",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "setup:roles": "node src/setupNovaRoles.js",
    "build:dashboard": "npm run build --prefix dashboard",
    "dev:dashboard": "npm run dev --prefix dashboard"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "cors": "^2.8.5",
    "discord.js": "^14.19.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  }
}
